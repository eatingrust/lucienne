{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "contracts/**/*.ts",
    "core/**/*.ts",
    "apps/main/**/*.ts",
    "apps/main/**/*.tsx",
    "vite.config.ts",
    "services/planner/**/*.ts",
    "services/preparation/**/*.ts",
    "services/telemetry/**/*.ts",
    "services/session/**/*.ts",
    "profiles/**/*.ts",
    "qa/**/*.ts",
    "adapters/**/*.ts"
  ]
}
